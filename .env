# Copiar este archivo como .env y completar los valores.

# URL de la API de cotizaciones del dolar.
API_URL=https://dolarapi.com/v1/dolares

# URL de conexion a la base de datos PostgreSQL.
# El proyecto usa PostgreSQL alojado en Supabase mediante el Session pooler
# (Supavisor) en el puerto 5432 con sslmode=require.
# Formato: postgresql+psycopg2://USUARIO:CLAVE@HOST:5432/BASE?sslmode=require
# Ejemplo:
#   DATABASE_URL=postgresql+psycopg2://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres.unszkfrivmfzmwfbpwdl:HerMoy-1989!@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
